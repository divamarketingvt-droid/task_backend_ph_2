# ===== Blizz Board backend on Hostinger (hPanel → Websites → Add website → Node.js Web App) =====
#
# Build settings in the Hostinger form:
#   Framework / preset : Express (or "Other")
#   Node version       : 22.x  (20.x also works)
#   Root directory     : backend      (or / if you upload only this folder)
#   Install command    : npm ci --omit=dev
#   Build command      : (leave empty)
#   Start command      : npm start          (runs node src/server.js)
#   Entry file         : src/server.js
#
# Environment variables: add each KEY = VALUE below (or use "Import .env" if shown).
# Replace <frontend-domain> and <backend-domain> with your Hostinger addresses, with https://
# and no / at the end. Secrets (marked SECRET) — copy them from your local .env, never commit them.
# Do NOT set PORT — Hostinger gives the app its own port.

# ---------- Required ----------
NODE_ENV=production
FRONTEND_URL=https://<frontend-domain>
BACKEND_URL=https://<backend-domain>
# Extra frontends allowed by CORS, comma separated (e.g. the www. version, the old Vercel site)
CORS_ORIGINS=https://www.<frontend-domain>,https://blizz-board-frontend.vercel.app
MONGO_URI=                          # SECRET  mongodb+srv://user:password@cluster/taskmanagement
JWT_SECRET=                         # SECRET  long random string (same as now, or everyone is logged out)
JWT_EXPIRE=7d
MEETING_TIME_ZONE=Asia/Kolkata
MEETING_REMINDER_MINUTES=15

# ---------- Email (Brevo) ----------
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=                          # SECRET  xxxx@smtp-brevo.com
SMTP_PASS=                          # SECRET  xsmtpsib-...
BREVO_API_KEY=                      # SECRET  xkeysib-...  (used first when set)
MAIL_FROM_EMAIL=                    # sender verified in Brevo → Senders
MAIL_FROM_NAME=Blizz Board

# ---------- File storage (Cloudinary) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=              # SECRET
CLOUDINARY_FOLDER=task-management

# ---------- Browser push notifications ----------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=                  # SECRET
VAPID_SUBJECT=mailto:<your-admin-email>

# ---------- Google Calendar / Meet (optional) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=               # SECRET
GOOGLE_REFRESH_TOKEN=               # SECRET
# Also add this exact address in Google Cloud Console → Credentials → Authorized redirect URIs
GOOGLE_REDIRECT_URI=https://<backend-domain>/oauth2callback

# ---------- Telegram bot (optional) ----------
TELEGRAM_BOT_TOKEN=                 # SECRET

# ---------- Video calls (optional) ----------
MEETING_JOIN_EARLY_MINUTES=15
MEETING_JOIN_LATE_MINUTES=30
MEETING_MAX_PARTICIPANTS=8
STUN_URLS=
TURN_URLS=
TURN_SECRET=
TURN_USERNAME=
TURN_CREDENTIAL=
WEBRTC_FORCE_RELAY=false

# ---------- Create tasks by email (optional) ----------
TASK_INBOX_ENABLED=false
TASK_INBOX_ADDRESS=
TASK_INBOX_IMAP_HOST=imap.gmail.com
TASK_INBOX_IMAP_PORT=993
TASK_INBOX_USER=
TASK_INBOX_PASS=                    # SECRET
TASK_INBOX_REQUIRE_AUTH=true
